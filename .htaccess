# Einheitliche Adresse: immer https://www.fahrschule-strauch.de (nur auf der echten Domain)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?fahrschule-strauch\.de$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.fahrschule-strauch.de%{REQUEST_URI} [L,R=301]
</IfModule>

# Alte Adressen der bisherigen Website (Apache)
ErrorDocument 404 /404.html
RedirectMatch 301 ^/index\.html$ /
Redirect 301 /ueber_uns.html /ueber-uns/
Redirect 301 /information.html /fuehrerschein/
Redirect 301 /begleitetes-fahren-ab-17.html /fuehrerschein/
Redirect 301 /berufskraftfahrer.html /berufskraftfahrer/
Redirect 301 /maxi.html /anmeldung/
Redirect 301 /kursangebot.html /anmeldung/
Redirect 301 /impressum.html /impressum/
Redirect 301 /index-ru.html /ru/
Redirect 301 /information-ru.html /ru/fuehrerschein/
Redirect 301 /kursangebot-ru.html /ru/anmeldung/
Redirect 301 /kontakt-ru.html /ru/kontakt/
Redirect 301 /impressum-ru.html /impressum/
Redirect 301 /images/pdf/Anmeldung.pdf /files/anmeldeformular.pdf
Redirect 301 /images/pdf/Formular-B.pdf /files/info-preise-klasse-b.pdf
Redirect 301 /images/pdf/Formular-BE.pdf /files/info-preise-klasse-be.pdf
Redirect 301 /images/pdf/Fuehrerscheinantrag.pdf /files/fuehrerscheinantrag.pdf

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Komprimierung für Text-Dateien
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>

# Gehashte Bausteine aus dem Build ändern sich nie
<IfModule mod_headers.c>
  <FilesMatch "^assets/.+\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
